# SocioMart - optional local overrides & production environment templates
#
# Copy this file to `.env` and adjust values ONLY if you need to change the
# defaults. The app runs out-of-the-box locally with H2 without this file.
#
# PORT: which port SocioMart listens on (defaults to 8081 when unset).
PORT=8081

# ---- Production (SPRING_PROFILES_ACTIVE=prod) Configuration Templates ----
# Required when running with the 'prod' profile against PostgreSQL (e.g., Supabase / Render).

# PostgreSQL JDBC URL (must begin with jdbc:postgresql://)
# Example: jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?sslmode=require
SOCIOMART_DB_JDBC_URL=jdbc:postgresql://localhost:5432/sociomart

# Database credentials
SOCIOMART_DB_USERNAME=postgres
SOCIOMART_DB_PASSWORD=your_secure_db_password

# SocioMart Admin and Super Admin passwords
# Required for production startup. Used to authenticate admin and super-admin roles.
SOCIOMART_ADMIN_PASSWORD=your_secure_admin_password
SOCIOMART_SUPER_ADMIN_PASSWORD=your_secure_super_admin_password

# Public base URL for building shareable kitchen links (optional, defaults to relative paths)
# Example: https://sociomart-demo.onrender.com
PUBLIC_BASE_URL=